GEMINI_API_KEY=your-gemini-api-key-here
PORT=3000

# La cuota gratuita de Gemini se cuenta POR MODELO, así que las operaciones se
# reparten para no compartir el mismo cupo diario. No usar alias `-latest`:
# resuelven a un modelo concreto y comparten su cuota.
#
# Los `-lite` generan 4 a 8 veces más rápido que los `flash` grandes (112-217
# tok/s contra 26-60), así que menú y compras comparten uno a propósito: los
# 22 segundos que tardaba el menú con `gemini-3.6-flash` pesaban más que tener
# cupo separado. Compras casi no lo usa porque la lista queda cacheada.
#
# Visión se queda en un `flash` grande: es el paso más delicado y la calidad
# vale la espera.
# GEMINI_MODEL_VISION=gemini-3.5-flash
# GEMINI_MODEL_MENU=gemini-3.1-flash-lite
# GEMINI_MODEL_RECIPE=gemini-3.5-flash-lite
# GEMINI_MODEL_SHOPPING=gemini-3.1-flash-lite

# Plan B cuando el principal devuelve 503 (saturado, tras un reintento) o 429
# (cupo agotado). Tiene que ser un modelo DISTINTO del principal de esa misma
# operación: la saturación y la cuota son por modelo.
# GEMINI_FALLBACK_VISION=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MENU=gemini-3.5-flash-lite
# GEMINI_FALLBACK_RECIPE=gemini-3.1-flash-lite
# GEMINI_FALLBACK_SHOPPING=gemini-3.5-flash-lite

# Mismo proyecto de Supabase que usa la app (Project Settings -> API).
# La anon key es pública por diseño: acá se usa solo para validar tokens de sesión.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
