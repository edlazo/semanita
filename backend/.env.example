GEMINI_API_KEY=your-gemini-api-key-here
PORT=3000

# La cuota gratuita de Gemini se cuenta POR MODELO, así que cada operación usa
# uno distinto para no compartir el mismo cupo diario. Sobreescribí solo si un
# modelo deja de estar disponible o querés cambiar la relación calidad/cupo.
# No usar alias `-latest`: resuelven a un modelo concreto y comparten su cuota.
# GEMINI_MODEL_VISION=gemini-3.5-flash
# GEMINI_MODEL_MENU=gemini-3.6-flash
# GEMINI_MODEL_RECIPE=gemini-3.5-flash-lite
# GEMINI_MODEL_SHOPPING=gemini-3.1-flash-lite

# Mismo proyecto de Supabase que usa la app (Project Settings -> API).
# La anon key es pública por diseño: acá se usa solo para validar tokens de sesión.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
